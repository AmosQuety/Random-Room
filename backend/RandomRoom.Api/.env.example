# Copy to .env and fill in. Never commit .env.
# 32+ random characters, e.g. from: openssl rand -base64 48
Room__JwtSigningKey=
# Npgsql connection string, or a postgres:// URL (as Render provides)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=randomroom;Username=postgres;Password=postgres
# Rooms with no activity for this many days are deleted with everything in them (default 30; 0 turns it off).
# Set it to the retention period you are allowed or required to keep data for.
# Room__RetentionDays=30
